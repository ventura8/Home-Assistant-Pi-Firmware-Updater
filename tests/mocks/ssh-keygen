#!/bin/bash
# Mock ssh-keygen
# Supports -f/-C key generation and -y public-key recovery.
# Mock key convention: a private key file whose content is a public key line
# "is" that key, so -y prints it back. An empty private key file recovers a
# fixed default key. MOCK_SSH_KEYGEN_DERIVE_FAIL=true makes -y fail.

comment=""
outfile=""
print_pub=false
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
    if [ "${args[$i]}" = "-f" ]; then
        outfile="${args[$((i + 1))]}"
    fi
    if [ "${args[$i]}" = "-C" ]; then
        comment="${args[$((i + 1))]}"
    fi
    if [ "${args[$i]}" = "-y" ]; then
        print_pub=true
    fi
    i=$((i + 1))
done

if [ "$print_pub" = true ]; then
    if [ "${MOCK_SSH_KEYGEN_DERIVE_FAIL:-}" = "true" ]; then
        echo "mock ssh-keygen -y: forced failure" >&2
        exit 1
    fi
    if [ -n "$outfile" ] && [ -f "$outfile" ]; then
        if [ -s "$outfile" ]; then
            cat "$outfile"
        else
            echo "ssh-rsa AAAAMOCKRECOVEREDKEYDATARRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR pi_firmware_updater"
        fi
        exit 0
    fi
    echo "mock ssh-keygen -y: missing key file" >&2
    exit 1
fi

if [ -n "$outfile" ]; then
    echo "ssh-rsa AAAAMOCKGENERATEDKEYDATAGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG ${comment}" > "$outfile"
    if [ -n "$comment" ]; then
        cp "$outfile" "${outfile}.pub"
    else
        touch "${outfile}.pub"
    fi
fi
exit 0
